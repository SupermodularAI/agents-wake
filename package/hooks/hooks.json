{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"${PLUGIN_ROOT}/bin/wake\" emit session-start", "async": true } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"${PLUGIN_ROOT}/bin/wake\" emit stop", "async": true } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "\"${PLUGIN_ROOT}/bin/wake\" emit session-end", "async": true } ] }
    ]
  }
}
